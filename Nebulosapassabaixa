import cv2
import numpy as np
import matplotlib.pyplot as plt

# Caminho da imagem
caminho_imagem = '/content/lagoa2.0PRONTA.jpeg'

# 1. Carregar a imagem em escala de cinza
img = cv2.imread(caminho_imagem, cv2.IMREAD_GRAYSCALE)
if img is None:
    raise FileNotFoundError(f"Imagem não encontrada em: {caminho_imagem}")

linhas, colunas = img.shape

# 2. Aplicar FFT SEM USAR fftshift (mantendo nos cantos)
f_transform = np.fft.fft2(img)

# 3. Criar o Filtro Passa-Baixa sem centralizar
# Nos dados brutos da FFT, as baixas frequências estão nos cantos (0,0).
# Para mantê-las, a máscara deve ser 1 nos cantos e 0 no centro.
# Uma forma simples de fazer isso sem shift é criar uma máscara centrada e invertê-la,
# ou criar a máscara diretamente nas quatro esquinas.
# Abaixo usamos uma abordagem limpa criando uma máscara central e invertendo (passa-baixa):

raio_filtro = 630  # Ajuste o raio conforme necessário

# Cria uma máscara preta (0)
mascara_central = np.zeros((linhas, colunas), np.uint8)
centro_r, centro_c = linhas // 2, colunas // 2

# Desenha um círculo branco no CENTRO com valor 1
cv2.circle(mascara_central, (centro_c, centro_r), raio_filtro, 1, -1)

# Inverte a máscara: o que era centro vira 0 (corta altas frequências)
# e o que era borda/cantos vira 1 (mantém baixas frequências)
mascara_passa_baixa = 1 - mascara_central

# 4. Aplicar a máscara ao espectro bruto
f_transform_filtrado = f_transform * mascara_passa_baixa

# 5. Calcular o espectro de magnitude bruto (com log para visualização)
# Usamos fftshift apenas para exibir o espectro bonitinho no gráfico centralizado
espectro_exibicao = 20 * np.log(np.abs(np.fft.fftshift(f_transform_filtrado)) + 1)

# 6. Transformada Inversa (IFFT) SEM shift inverso
f_inv = np.fft.ifft2(f_transform_filtrado)

# Processar imagem reconstruída
img_reconstruida = np.abs(f_inv)
img_suavizada = cv2.normalize(img_reconstruida, None, 255, 0, cv2.NORM_MINMAX, cv2.CV_8U)

# 7. Plotar os resultados
plt.figure(figsize=(16, 8))

plt.subplot(1, 3, 1)
plt.imshow(img, cmap='gray')
plt.title('Imagem Original')
plt.axis('off')

plt.subplot(1, 3, 2)
plt.imshow(espectro_exibicao, cmap='inferno')
plt.title(f'Espectro Passa-Baixa (Raio={raio_filtro})')
plt.axis('off')

plt.subplot(1, 3, 3)
plt.imshow(img_suavizada, cmap='gray')
plt.title('Nebulosa Suavizada (Apenas Baixas Freq.)')
plt.axis('off')

plt.tight_layout()
plt.show()
