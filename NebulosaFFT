import cv2
import numpy as np
import matplotlib.pyplot as plt

# Caminho da imagem no Google Colab
caminho_imagem = '/content/lagoa2.0PRONTA.jpeg'

# 1. Carregar a imagem em escala de cinza
img = cv2.imread(caminho_imagem, cv2.IMREAD_GRAYSCALE)
if img is None:
    raise FileNotFoundError(f"Não foi possível carregar a imagem em: {caminho_imagem}")

# 2. Aplicar a Transformada de Fourier 2D
f_transform = np.fft.fft2(img)

# 3. Deslocar o componente DC para o centro para gerar o espectro visualizável
f_shift = np.fft.fftshift(f_transform)
magnitude_spectrum = 20 * np.log(np.abs(f_shift) + 1)

# 4. Aplicar a Transformada Inversa de Fourier (IFFT) para voltar à imagem original
# (Como não aplicamos nenhum filtro, a IFFT reconduz a imagem de volta ao domínio espacial)
f_ishift = np.fft.ifftshift(f_shift)       # Desfaz o shift do centro
img_reconstruida_complexa = np.fft.ifft2(f_ishift)  # Aplica a inversa

# O resultado da IFFT pode conter pequenos resíduos imaginários devido a imprecisões de ponto flutuante.
# Pegamos o valor absoluto (magnitude) para obter a imagem real.
img_reconstruida = np.abs(img_reconstruida_complexa)

# Normaliza para garantir que os valores fiquem no intervalo padrão de imagem (0 a 255)
img_reconstruida = cv2.normalize(img_reconstruida, None, 255, 0, cv2.NORM_MINMAX, cv2.CV_8U)

# 5. Plotar os três passos lado a lado: Original -> Espectro -> Reconstruída
plt.figure(figsize=(18, 6))

plt.subplot(1, 3, 1)
plt.imshow(img, cmap='gray')
plt.title('1. Imagem Original')
plt.axis('off')

plt.subplot(1, 3, 2)
plt.imshow(magnitude_spectrum, cmap='inferno')
plt.title('2. Espectro de Frequência (FFT)')
plt.colorbar(label='Magnitude (dB)')
plt.axis('off')

plt.subplot(1, 3, 3)
plt.imshow(img_reconstruida, cmap='gray')
plt.title('3. Imagem Reconstruída (Inversa)')
plt.axis('off')

plt.tight_layout()
plt.show()
